# Slack tokens for the console process (channels/slack.py). Copy to deploy/secrets/slack.env, fill in,
# chmod 600, then: docker compose -f deploy/compose.yaml up -d ui
#   SLACK_BOT_TOKEN  OAuth & Permissions → Bot User OAuth Token (xoxb-...)
#   SLACK_APP_TOKEN  Basic Information → App-Level Tokens, scope connections:write (xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
