# Copy to deploy/.env and change what differs on this machine. Paths are relative to deploy/.
# COMPOSE_PROJECT_NAME=myorch
# MYORCH_KNOWLEDGE_DIR=../../myorch-knowledge
# MYORCH_DATA_DIR=../../myorch-data
# MYORCH_VOLUME=myorch-artifacts
# MYORCH_UI_PORT=8800
# TEMPORAL_PORT=7233
# TEMPORAL_UI_PORT=8233
# TZ=Asia/Shanghai
# MYORCH_SECRETS_DIR=./secrets
# Claude on Google Vertex AI (provider `claude` of type claude-code-vertex, see providers.example.yaml).
# Unset: the claude-code harness uses api.anthropic.com.
# MYORCH_VERTEX_PROJECT=<gcp project>
# MYORCH_VERTEX_REGION=global
# Host folder whose subfolders can be registered as knowledge sources (kind: dir) and mounted from
# the console too; mounted read-only into the console and worker at the same path.
# MYORCH_KB_ROOT=/Users/<you>/orca/kb      (an absolute path: compose does not expand ~ here)
