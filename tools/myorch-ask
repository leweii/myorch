#!/usr/bin/env python3
"""Ask the user a question and pause this step until they reply.

Usage: myorch-ask "question" [--option "A" --option "B"]

Writes /sandbox/out/.myorch/question.json. The agent should end its turn right after;
the user's reply arrives as the next turn's prompt.
"""
import argparse
import json
import os
import sys

OUT = os.environ.get("MYORCH_OUT_DIR", "/sandbox/out")

p = argparse.ArgumentParser(prog="myorch-ask")
p.add_argument("question")
p.add_argument("--option", action="append", default=[], help="a suggested answer (repeatable)")
args = p.parse_args()

if os.environ.get("MYORCH_INTERACTION") != "allowed":
    # /sandbox/bin is mounted in every step (for myorch-checks); only some steps may ask.
    sys.exit("myorch-ask: this step may not ask the user. Decide yourself as the step instructions say, or stop and write down why.")
if not args.question.strip():
    sys.exit("myorch-ask: question must not be empty")

path = os.path.join(OUT, ".myorch", "question.json")
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w", encoding="utf-8") as f:
    json.dump({"question": args.question.strip(), "options": args.option}, f, ensure_ascii=False)

print("The question has been sent to the user. End this turn now and do not continue; the user's reply arrives as your next turn.")
