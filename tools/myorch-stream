#!/usr/bin/env python3
"""Turn Claude Code's stream-json output into a readable log, line by line, as it arrives.

Usage: claude -p ... --output-format stream-json --verbose | myorch-stream [RAW_FILE]

Reads JSON lines on stdin. Writes one readable line (or a few) per event to stdout, flushed at
once, so the worker can follow the step's log while it runs. Copies every input line unchanged to
RAW_FILE when given. Lines that are not JSON pass through as they are.

Readable form:
    · 会话开始 (model)          system init
    agent text                   assistant text, as written
    → Tool: what                 a tool call (Bash command, file path, pattern, ...)
      ← first lines of result    the tool's result, cut short; "✗" when it is an error
    ═══ 结果 ═══                  the result event: the final answer (unless it was the last text
                                 shown), then a summary line
"""
import json
import sys

RESULT_LINES = 3
RESULT_CHARS = 300
INPUT_CHARS = 200


def one_line(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def tool_target(name, inp):
    if not isinstance(inp, dict):
        return ""
    for k in ("command", "file_path", "path", "pattern", "url", "query", "description", "prompt"):
        if inp.get(k):
            return one_line(inp[k], INPUT_CHARS)
    return one_line(json.dumps(inp, ensure_ascii=False), INPUT_CHARS)


def result_text(content):
    if isinstance(content, list):
        content = "\n".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
    lines = [ln for ln in str(content or "").splitlines() if ln.strip()]
    out = [one_line(ln, RESULT_CHARS) for ln in lines[:RESULT_LINES]]
    if len(lines) > RESULT_LINES:
        out.append(f"…（共 {len(lines)} 行）")
    return out


LAST = {"text": ""}  # the last assistant text, so the result does not repeat it


def render(ev):
    t = ev.get("type")
    if t == "system" and ev.get("subtype") == "init":
        return [f"· 会话开始（{ev.get('model', '')}）"]
    if t == "assistant":
        out = []
        for c in (ev.get("message") or {}).get("content") or []:
            if c.get("type") == "text" and c.get("text", "").strip():
                LAST["text"] = c["text"].strip()
                out += c["text"].rstrip().splitlines()
            elif c.get("type") == "tool_use":
                out.append(f"→ {c.get('name', '?')}: {tool_target(c.get('name'), c.get('input'))}")
        return out
    if t == "user":
        out = []
        content = (ev.get("message") or {}).get("content")
        for c in content if isinstance(content, list) else []:
            if isinstance(c, dict) and c.get("type") == "tool_result":
                mark = "✗" if c.get("is_error") else "←"
                lines = result_text(c.get("content"))
                out += [f"  {mark} {ln}" for ln in lines] or [f"  {mark} （无输出）"]
        return out
    if t == "result":
        out = ["═══ 结果 ═══"]
        if ev.get("result") and str(ev["result"]).strip() != LAST["text"]:
            out += str(ev["result"]).rstrip().splitlines()
        parts = [ev.get("subtype", "")]
        if ev.get("num_turns") is not None:
            parts.append(f"{ev['num_turns']} 轮")
        if ev.get("duration_ms") is not None:
            parts.append(f"{ev['duration_ms'] / 1000:.0f} 秒")
        if ev.get("total_cost_usd") is not None:
            parts.append(f"${ev['total_cost_usd']:.2f}")
        out.append("· " + "，".join(p for p in parts if p))
        return out
    return []


def main():
    raw = open(sys.argv[1], "a", encoding="utf-8") if len(sys.argv) > 1 else None
    for line in sys.stdin:
        if raw:
            raw.write(line)
            raw.flush()
        try:
            ev = json.loads(line)
        except ValueError:
            ev = None
        if not isinstance(ev, dict):
            if line.strip():
                sys.stdout.write(line if line.endswith("\n") else line + "\n")
                sys.stdout.flush()
            continue
        try:
            out = render(ev)
        except Exception as e:  # an unexpected event shape must not stop the log
            out = [f"· （无法显示的事件 {ev.get('type')}: {e}）"]
        if out:
            sys.stdout.write("\n".join(out) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
